APP_NAME=Dominic Backend
ENVIRONMENT=local
DEBUG=false
ENABLE_DEBUG_ENV=false

AUTH_SECRET_KEY=change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=43200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE_BACKEND=database
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_RESET_PASSWORD_REQUESTS=5
RATE_LIMIT_AUTH_RESET_PASSWORD_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_STREAM_REQUESTS=10
RATE_LIMIT_CHAT_STREAM_WINDOW_SECONDS=60
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=16

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_ORIGIN_REGEX=

DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dominic
DB_PASSWORD=your_database_password_here
DB_NAME=chatbot_db
DB_SSL=false
DB_SSL_CA=
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
MIGRATION_VALIDATION_ENABLED=true
MIGRATION_VALIDATION_MODE=strict

LLM_DEFAULT_PROVIDER=ninerouter
LLM_DEFAULT_MODEL=gpt-5.4
# Optional provider catalog overrides. Precedence:
# 1) LLM_PROVIDER_CATALOG_JSON when non-empty
# 2) LLM_PROVIDER_CATALOG_FILE when non-empty, resolved relative to the backend project root
# 3) built-in OpenAI-compatible catalog
# Model-level contextWindow/maxOutputTokens override the fallback globals below.
# Example shape:
# LLM_PROVIDER_CATALOG_JSON=[{"id":"custom-openai","label":"Custom OpenAI Compatible","type":"openai-compatible","baseUrlEnv":"CUSTOM_OPENAI_BASE_URL","apiKeyEnv":"CUSTOM_OPENAI_API_KEY","enabled":true,"models":[{"id":"custom-model","label":"Custom Model","displayProvider":"Custom","model":"custom-model-name","enabled":true,"default":true,"contextWindow":128000,"maxOutputTokens":4096,"capabilities":{"reasoningEffort":{"enabled":false,"userConfigurable":false}}}]}]
LLM_PROVIDER_CATALOG_JSON=
# Example file override. The file should contain provider metadata and env var names only, not secrets.
LLM_PROVIDER_CATALOG_FILE=
# LLM_PROVIDER_CATALOG_FILE=config/llm_provider_catalog.json
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=your_ninerouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
# Fallback token limits used when a catalog model omits contextWindow/maxOutputTokens.
LLM_CONTEXT_WINDOW=200000

CONTEXT_WINDOW_SIZE=8
SUMMARY_TRIGGER_MESSAGES=10
SUMMARY_MAX_TOKENS=220
CHAT_MESSAGE_MAX_LENGTH=12000
MAX_OUTPUT_TOKENS=5000
ROLLING_WINDOW_HOURS=2
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4

# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER: 'local' (default, no external service), 'ollama', or 'api'
# EMBEDDING_MODEL:    model name used by the selected provider
#   - local provider  → local-hash-v1
#   - ollama provider → qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS: vector length; must match the Qdrant collection size
#   - local-hash-v1          → 64
#   - qwen3-embedding:0.6b   → detect on first call (typically 1024)
# EMBEDDING_BASE_URL: Ollama server URL (only used when EMBEDDING_PROVIDER=ollama)
#   Topology options:
#     Backend runs directly on Windows host  → http://localhost:11434
#     Backend in Docker, Ollama on host      → http://host.docker.internal:11434
#     Ollama as a Compose service            → http://ollama:11434
# EMBEDDING_TIMEOUT_SECONDS: HTTP timeout per Ollama request (default 60)
# EMBEDDING_BATCH_SIZE: max texts per single /api/embed call (default 16)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=64
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# API embedding provider examples (Multi-Provider API Embedding)
# ---------------------------------------------------------------------------
# To use an external API embedding provider, replace the block above with
# one of the examples below.
#
# --- OpenAI text-embedding-3-small ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BASE_URL=https://api.openai.com
#   EMBEDDING_API_KEY=sk-your-openai-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_text_embedding_3_small
#
# --- Cohere embed-english-v3.0 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=cohere
#   EMBEDDING_MODEL=embed-english-v3.0
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.cohere.com
#   EMBEDDING_API_KEY=your-cohere-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_embed_english_v3_0
#
# --- Voyage voyage-3 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=voyage
#   EMBEDDING_MODEL=voyage-3
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.voyageai.com
#   EMBEDDING_API_KEY=your-voyage-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_voyage_3
#
# IMPORTANT: Do NOT reuse the same collection for different embedding
# providers/models.  Each provider/model produces vectors in a different
# embedding space.  Mixing them produces meaningless similarity scores.
# Always use a dedicated collection per provider/model.
# Use the probe script to validate connectivity before switching:
#   python scripts/embedding_provider_probe.py
# ---------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=database
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=knowledge_chunks
VECTOR_STORE_TIMEOUT_SECONDS=10
VECTOR_STORE_PREFER_GRPC=false
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TOPIC=general
WEB_SEARCH_QUERY_PLANNER_ENABLED=true
WEB_SEARCH_QUERY_PLANNER_MODEL=gpt-5.4-mini
WEB_SEARCH_QUERY_PLANNER_MAX_QUERIES=4
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_SECONDS=12

# ---------------------------------------------------------------------------
# Remote MCP (Model Context Protocol) foundation
# ---------------------------------------------------------------------------
# Disabled by default. Backend-only: frontend never calls MCP remotes directly.
# Server registry is admin-controlled via config/mcp_servers.json.
MCP_ENABLED=false
MCP_REMOTE_ENABLED=true
MCP_CONFIG_FILE=config/mcp_servers.json
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_TOOL_INVOCATION_ENABLED=true
MCP_ARTIFACT_STORAGE_MODE=inline
MCP_TOTAL_BUDGET_SECONDS=60
MCP_TOOL_CACHE_TTL_SECONDS=300
MCP_MAX_ARTIFACT_CONTENT_BYTES=512000
# Optional Excalidraw server overrides; no real secrets in this example file.
# MCP_SERVER_EXCALIDRAW_ENABLED=true
# MCP_SERVER_EXCALIDRAW_URL=https://mcp.excalidraw.com
# MCP_SERVER_EXCALIDRAW_TIMEOUT=30
# MCP_SERVER_EXCALIDRAW_TOOL_ALLOWLIST=create-excalidraw,export-image
# MCP_SERVER_EXCALIDRAW_AUTH_STRATEGY=bearer
# MCP_SERVER_EXCALIDRAW_AUTH_SECRET_ENV=MCP_EXCALIDRAW_AUTH_TOKEN
# MCP_EXCALIDRAW_AUTH_TOKEN=replace-with-token-if-required

CHUNK_SIZE=800
CHUNK_OVERLAP=100
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_KNOWLEDGE_UPLOAD_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_UPLOAD_WINDOW_SECONDS=300
RATE_LIMIT_KNOWLEDGE_INGEST_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_INGEST_WINDOW_SECONDS=300

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=dominic-knowledge
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_SECURE=true
OBJECT_STORAGE_LOCAL_PATH=.storage
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
INGESTION_RECOVERY_ENABLED=true
INGESTION_RECOVERY_MAX_JOBS=20
INGESTION_STUCK_JOB_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Optional rag-core API service mode
# ---------------------------------------------------------------------------
# library = current in-process rag_core package path.
# api     = delegate embedding/vector/ranking/context operations to the
#           internal rag-core FastAPI service.
# Local Windows + docker-compose.local-rag.yml:
#   RAG_CORE_MODE=api
#   RAG_CORE_BASE_URL=http://127.0.0.1:8010
#   RAG_CORE_API_KEY=local-rag-core-dev-key
RAG_CORE_MODE=library
RAG_CORE_BASE_URL=http://rag-core:8010
RAG_CORE_API_KEY=
RAG_CORE_TIMEOUT_SECONDS=60

# One-off data migration helper (legacy MySQL -> current Postgres)
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
