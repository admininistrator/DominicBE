# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER: 'local' (default, no external service), 'ollama', or 'api'
# EMBEDDING_MODEL:    model name used by the selected provider
#   - local provider  → local-hash-v1
#   - ollama provider → qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS: vector length; must match the Qdrant collection size
#   - local-hash-v1          → 64
#   - qwen3-embedding:0.6b   → detect on first call (typically 1024)
# EMBEDDING_BASE_URL: Ollama server URL (only used when EMBEDDING_PROVIDER=ollama)
#   Topology options:
#     Backend runs directly on Windows host  → http://localhost:11434
#     Backend in Docker, Ollama on host      → http://host.docker.internal:11434
#     Ollama as a Compose service            → http://ollama:11434
# EMBEDDING_TIMEOUT_SECONDS: HTTP timeout per Ollama request (default 60)
# EMBEDDING_BATCH_SIZE: max texts per single /api/embed call (default 16)

# --- Default: local hash provider (no Ollama required) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=64
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Qwen3 embedding recommendation (P02-T04)
# ---------------------------------------------------------------------------
# To activate Qwen3 semantic embeddings, replace the block above with:
#
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=qwen3-embedding:0.6b
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=http://localhost:11434
#   EMBEDDING_TIMEOUT_SECONDS=60
#   EMBEDDING_BATCH_SIZE=16
#
# IMPORTANT: use a dedicated Qdrant collection to avoid mixing embedding spaces.
# Change VECTOR_STORE_COLLECTION below to knowledge_qwen3_embedding_06b when
# switching to the Ollama provider.  Do NOT reuse knowledge_chunks (local-hash).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# API embedding provider examples (Multi-Provider API Embedding)
# ---------------------------------------------------------------------------
# To use an external API embedding provider, replace the block above with
# one of the examples below.
#
# --- OpenAI text-embedding-3-small ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BASE_URL=https://api.openai.com
#   EMBEDDING_API_KEY=sk-your-openai-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_text_embedding_3_small
#
# --- NVIDIA NIM / integrade API (OpenAI-compatible) ---
#   NVIDIA's embedding API uses the OpenAI-compatible /v1/embeddings format.
#   The adapter is mapped explicitly via EMBEDDING_API_TYPE=nvidia.
#   EMBEDDING_BASE_URL must NOT include a /v1 suffix since the adapter
#   appends /v1/embeddings automatically.  Set it to:
#     https://integrate.api.nvidia.com
#   (no trailing /v1, no trailing slash).
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=nvidia
#   EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
#   EMBEDDING_DIMENSIONS=2048
#   EMBEDDING_BASE_URL=https://integrate.api.nvidia.com
#   EMBEDDING_API_KEY=your_nvidia_api_key_here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_nvidia_llama_nemotron_embed_1b_v2
#
# --- Cohere embed-english-v3.0 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=cohere
#   EMBEDDING_MODEL=embed-english-v3.0
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.cohere.com
#   EMBEDDING_API_KEY=your-cohere-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_embed_english_v3_0
#
# --- Voyage voyage-3 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=voyage
#   EMBEDDING_MODEL=voyage-3
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.voyageai.com
#   EMBEDDING_API_KEY=your-voyage-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_voyage_3
#
# IMPORTANT: Do NOT reuse the same collection for different embedding
# providers/models.  Each provider/model produces vectors in a different
# embedding space.  Mixing them produces meaningless similarity scores.
# Always use a dedicated collection per provider/model.
# Use the probe script to validate connectivity before switching:
#   python scripts/embedding_provider_probe.py
#
# IMPORTANT (NVIDIA-specific):
#   - EMBEDDING_BASE_URL must NOT include a trailing /v1 suffix.  The
#     adapter appends /v1/embeddings automatically.  Use:
#       https://integrate.api.nvidia.com
#   - Do NOT add a trailing slash at the end of BASE_URL.
#   - EMBEDDING_API_TYPE=nvidia is REQUIRED (not 'openai') — it maps to
#     the same OpenAI-compatible adapter but is explicitly recognized.
#   - VECTOR_STORE_COLLECTION must match the naming convention.  For
#     model=nvidia/llama-nemotron-embed-1b-v2 and provider=api, the
#     expected name is:
#       knowledge_api_nvidia_llama_nemotron_embed_1b_v2
#   - If you change EMBEDDING_MODEL or EMBEDDING_DIMENSIONS, you MUST
#     create a new collection and re-index existing documents.  Mixing
#     dimensions within a collection causes Qdrant dimension conflicts.
# ---------------------------------------------------------------------------

VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=knowledge_chunks
