APP_NAME=Dominic Backend
ENVIRONMENT=local
DEBUG=true
ENABLE_DEBUG_ENV=false

AUTH_SECRET_KEY=change-this-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=43200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE_BACKEND=database
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_RESET_PASSWORD_REQUESTS=5
RATE_LIMIT_AUTH_RESET_PASSWORD_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_STREAM_REQUESTS=10
RATE_LIMIT_CHAT_STREAM_WINDOW_SECONDS=60
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=16

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOW_ORIGIN_REGEX=

DATABASE_URL=postgresql+psycopg://dominic:dominic_dev_password@127.0.0.1:5432/chatbot_db
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
MIGRATION_VALIDATION_ENABLED=true
MIGRATION_VALIDATION_MODE=strict

GITHUB_COPILOT_API_KEY=
MODEL_GITHUB_COPILOT=gpt-5.4
SUPPORTED_CHAT_MODELS=gpt-5.3-codex,gpt-5.4,gemini-3.1-pro-preview,claude-haiku-4.5,gpt-5.4-mini,claude-sonnet-4.6,claude-opus-4.6,deepseek-v4-pro,kc/nvidia/nemotron-3-super-120b-a12b:free,kc/moonshotai/kimi-k2.6,kc/inclusionai/ling-2.6-1t:free,kc/qwen/qwen3.6-plus,kc/minimax/minimax-m2.7
NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
LLM_CONTEXT_WINDOW=200000
LLM_REASONING_EFFORT=
DEEPSEEK_V4_PRO_TARGET=kc/deepseek/deepseek-chat

CONTEXT_WINDOW_SIZE=8
SUMMARY_TRIGGER_MESSAGES=10
SUMMARY_MAX_TOKENS=220
CHAT_MESSAGE_MAX_LENGTH=12000
MAX_OUTPUT_TOKENS=5000
ROLLING_WINDOW_HOURS=2
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=64
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://127.0.0.1:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=knowledge_chunks
VECTOR_STORE_TIMEOUT_SECONDS=10
VECTOR_STORE_PREFER_GRPC=false
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TOPIC=general
WEB_SEARCH_QUERY_PLANNER_ENABLED=true
WEB_SEARCH_QUERY_PLANNER_MODEL=gpt-5.4-mini
WEB_SEARCH_QUERY_PLANNER_MAX_QUERIES=4
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_SECONDS=12
CHUNK_SIZE=800
CHUNK_OVERLAP=100
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_KNOWLEDGE_UPLOAD_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_UPLOAD_WINDOW_SECONDS=300
RATE_LIMIT_KNOWLEDGE_INGEST_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_INGEST_WINDOW_SECONDS=300

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=dominic-knowledge
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin123
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_LOCAL_PATH=.storage
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
INGESTION_RECOVERY_ENABLED=true
INGESTION_RECOVERY_MAX_JOBS=20
INGESTION_STUCK_JOB_TIMEOUT_SECONDS=900

# One-off data migration helper (legacy MySQL -> current Postgres)
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=