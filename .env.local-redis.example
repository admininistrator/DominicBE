# ---------------------------------------------------------------------------
# Redis + Celery local development example
# ---------------------------------------------------------------------------
# Safe placeholder password for the local Docker Redis service only.
# Change this in your private .env if you expose Redis beyond localhost.
REDIS_PASSWORD=redis_dev_password

# Feature flag for Celery-backed async ingestion.
# Default is false so the existing synchronous/local fallback remains safe.
CELERY_ENABLED=false

# Celery broker URL used by the backend or a worker running on the Windows host.
# Uses Redis DB 0 and the localhost Redis port published by docker-compose.local-redis.yml.
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0

# Celery result backend used for short-lived task status/results.
# Uses Redis DB 1 to keep result metadata separate from broker queues.
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/1

# Windows host worker command must use --pool=solo:
# .venv\Scripts\celery -A app.worker.celery_app worker --loglevel=info --pool=solo -Q celery,ingestion
# Docker worker command uses --concurrency=2 and internal Redis URL redis://:${REDIS_PASSWORD}@redis:6379/0.
