# Docker Compose project name
COMPOSE_PROJECT_NAME=dominicapp

# Frontend build-time values
FRONTEND_VITE_API_BASE_URL=https://api.dominicapp.dev
FRONTEND_VITE_API_TIMEOUT_MS=120000

# Infrastructure containers
POSTGRES_DB=chatbot_db
POSTGRES_USER=dominic
POSTGRES_PASSWORD=change-this-postgres-password
MINIO_ROOT_USER=dominicminio
MINIO_ROOT_PASSWORD=change-this-minio-password

# ---------------------------------------------------------------------------
# Redis + Celery (Docker-internal only)
# ---------------------------------------------------------------------------
# WARNING: never expose port 6379 publicly. Redis must stay on the internal Docker network.
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/1

# Backend runtime
APP_NAME=Dominic Backend
ENVIRONMENT=prod
DEBUG=false
ENABLE_DEBUG_ENV=false

AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=43200
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORE_BACKEND=database
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60
RATE_LIMIT_AUTH_LOGIN_REQUESTS=5
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_REQUESTS=3
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_RESET_PASSWORD_REQUESTS=5
RATE_LIMIT_AUTH_RESET_PASSWORD_WINDOW_SECONDS=300
RATE_LIMIT_CHAT_REQUESTS=20
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_STREAM_REQUESTS=10
RATE_LIMIT_CHAT_STREAM_WINDOW_SECONDS=60
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=16

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2

CORS_ORIGINS=https://dominicapp.dev,https://www.dominicapp.dev
CORS_ALLOW_ORIGIN_REGEX=

# Point to Docker service names inside the compose network.
DATABASE_URL=postgresql+psycopg://dominic:change-this-postgres-password@postgres:5432/chatbot_db
DB_SSL=false
DB_SSL_CA=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
DB_READ_TIMEOUT=30
DB_WRITE_TIMEOUT=30
MIGRATION_VALIDATION_ENABLED=true
MIGRATION_VALIDATION_MODE=strict

GITHUB_COPILOT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
MODEL_GITHUB_COPILOT=gpt-5.4
SUPPORTED_CHAT_MODELS=gpt-5.3-codex,gpt-5.4,gemini-3.1-pro-preview,claude-haiku-4.5,gpt-5.4-mini,claude-sonnet-4.6,claude-opus-4.6,deepseek-v4-pro,kc/nvidia/nemotron-3-super-120b-a12b:free,kc/moonshotai/kimi-k2.6,kc/inclusionai/ling-2.6-1t:free,kc/qwen/qwen3.6-plus,kc/minimax/minimax-m2.7

# If 9router is running on the EC2 host itself, keep host.docker.internal.
# Otherwise replace with your external 9router/LiteLLM gateway URL.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
LLM_CONTEXT_WINDOW=200000
LLM_REASONING_EFFORT=
DEEPSEEK_V4_PRO_TARGET=kc/deepseek/deepseek-chat

CONTEXT_WINDOW_SIZE=8
SUMMARY_TRIGGER_MESSAGES=10
SUMMARY_MAX_TOKENS=220
CHAT_MESSAGE_MAX_LENGTH=12000
MAX_OUTPUT_TOKENS=5000
ROLLING_WINDOW_HOURS=2
TOKEN_ESTIMATE_CHARS_PER_TOKEN=4

# ---------------------------------------------------------------------------
# Embedding provider
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER: 'local' (default, no external service), 'ollama', or 'api'
# EMBEDDING_MODEL:    model name used by the selected provider
#   - local provider  → local-hash-v1
#   - ollama provider → qwen3-embedding:0.6b
# EMBEDDING_DIMENSIONS: vector length; must match the Qdrant collection size
#   - local-hash-v1          → 64
#   - qwen3-embedding:0.6b   → detect on first call (typically 1024)
# EMBEDDING_BASE_URL: Ollama server URL (only used when EMBEDDING_PROVIDER=ollama)
#   Topology options:
#     Backend runs directly on Windows host  → http://localhost:11434
#     Backend in Docker, Ollama on host      → http://host.docker.internal:11434
#     Ollama as a Compose service            → http://ollama:11434
# EMBEDDING_TIMEOUT_SECONDS: HTTP timeout per Ollama request (default 60)
# EMBEDDING_BATCH_SIZE: max texts per single /api/embed call (default 16)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_DIMENSIONS=64
EMBEDDING_BASE_URL=http://ollama:11434
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# API embedding provider examples (Multi-Provider API Embedding)
# ---------------------------------------------------------------------------
# To use an external API embedding provider, replace the block above with
# one of the examples below.
#
# Note: For API providers (openai/cohere/voyage), EMBEDDING_BASE_URL points
# to an external HTTPS URL — Docker service names (e.g. http://ollama:11434)
# do NOT apply.  These endpoints are reachable from inside the Docker network
# as long as internet egress is available.
#
# --- OpenAI text-embedding-3-small ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_BASE_URL=https://api.openai.com
#   EMBEDDING_API_KEY=sk-your-openai-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_text_embedding_3_small
#
# --- Cohere embed-english-v3.0 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=cohere
#   EMBEDDING_MODEL=embed-english-v3.0
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.cohere.com
#   EMBEDDING_API_KEY=your-cohere-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_embed_english_v3_0
#
# --- Voyage voyage-3 ---
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_TYPE=voyage
#   EMBEDDING_MODEL=voyage-3
#   EMBEDDING_DIMENSIONS=1024
#   EMBEDDING_BASE_URL=https://api.voyageai.com
#   EMBEDDING_API_KEY=your-voyage-key-here
#   EMBEDDING_TIMEOUT_SECONDS=30
#   EMBEDDING_BATCH_SIZE=64
#   VECTOR_STORE_COLLECTION=knowledge_api_voyage_3
#
# IMPORTANT: Do NOT reuse the same collection for different embedding
# providers/models.  Each provider/model produces vectors in a different
# embedding space.  Mixing them produces meaningless similarity scores.
# Always use a dedicated collection per provider/model.
# Use the probe script to validate connectivity before switching:
#   python scripts/embedding_provider_probe.py
# ---------------------------------------------------------------------------

VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_URL=http://qdrant:6333
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=knowledge_chunks
VECTOR_STORE_TIMEOUT_SECONDS=10
VECTOR_STORE_PREFER_GRPC=false

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_MIN_LEXICAL_SCORE=0.1
RETRIEVAL_HYBRID_SEMANTIC_WEIGHT=0.4
RETRIEVAL_HYBRID_LEXICAL_WEIGHT=0.6
RETRIEVAL_ENABLE_QUERY_EXPANSION=true
RETRIEVAL_MAX_RERANK_CANDIDATES=12
RETRIEVAL_RERANK_TITLE_WEIGHT=0.15
RETRIEVAL_RERANK_POSITION_WEIGHT=0.1
RETRIEVAL_LOW_CONFIDENCE_SCORE=0.2
RETRIEVAL_STRICT_GROUNDING_FOR_SCOPED_DOCS=true
RETRIEVAL_MAX_CONTEXT_TOKENS=4000
RETRIEVAL_MAX_CONTEXT_CHUNKS=6
ANSWER_GUARDRAILS_ENABLED=true
ANSWER_GUARDRAILS_ALLOW_WEAK_CITATIONS=false

WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TOPIC=general
WEB_SEARCH_QUERY_PLANNER_ENABLED=true
WEB_SEARCH_QUERY_PLANNER_MODEL=gpt-5.4-mini
WEB_SEARCH_QUERY_PLANNER_MAX_QUERIES=4
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=advanced
TAVILY_TIMEOUT_SECONDS=12

CHUNK_SIZE=800
CHUNK_OVERLAP=100
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=20
RATE_LIMIT_KNOWLEDGE_UPLOAD_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_UPLOAD_WINDOW_SECONDS=300
RATE_LIMIT_KNOWLEDGE_INGEST_REQUESTS=10
RATE_LIMIT_KNOWLEDGE_INGEST_WINDOW_SECONDS=300

OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_BUCKET=dominic-knowledge
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=dominicminio
OBJECT_STORAGE_SECRET_KEY=change-this-minio-password
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_LOCAL_PATH=.storage
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
INGESTION_RECOVERY_ENABLED=true
INGESTION_RECOVERY_MAX_JOBS=20
INGESTION_STUCK_JOB_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# rag-core API service mode
# ---------------------------------------------------------------------------
RAG_CORE_MODE=api
RAG_CORE_BASE_URL=http://rag-core:8010
RAG_CORE_API_KEY=replace-with-a-long-random-internal-rag-core-secret
RAG_CORE_TIMEOUT_SECONDS=60

LLM_VISION_ENABLED=true
LLM_IMAGE_CAPTIONING_ENABLED=false
LLM_IMAGE_CAPTION_MAX_TOKENS=256
LLM_CHAT_IMAGE_MAX_SIZE_MB=5
LLM_IMAGE_RESIZE_ENABLED=true
LLM_IMAGE_MAX_DIMENSION=1568
LLM_IMAGE_OCR_ENABLED=true
LLM_IMAGE_OCR_CONFIDENCE_THRESHOLD=0.55
LLM_PROMPT_CACHING_ENABLED=true
LLM_PROMPT_CACHING_MIN_CHARS=3000

INGESTION_MAX_RETRIES=3
INGESTION_RETRY_DELAY_SECONDS=2
AUDIT_LOG_ENABLED=true

RUN_MIGRATIONS=1
WAIT_FOR_DATABASE=1
DB_WAIT_RETRIES=30
DB_WAIT_SLEEP_SECONDS=2
